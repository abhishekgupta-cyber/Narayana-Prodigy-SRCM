# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma production deployment.
DATABASE_URL="postgresql://postgres:password@localhost:5432/narayana_crm?schema=public"

# SEED_ADMIN_PASSWORD: Initial password for the seeded Super Admin (forced change on first login).
SEED_ADMIN_PASSWORD=""
VITE_SEED_ADMIN_PASSWORD=""

# SESSION_SECRET: Cryptographic secret for signing httpOnly session cookies.
SESSION_SECRET="replace-with-64-char-hex-secret"

# GOVT_ID_ENCRYPTION_KEY: 32-byte key for encrypting StudentProfile.govt_id at rest.
GOVT_ID_ENCRYPTION_KEY="replace-with-32-byte-encryption-key"
