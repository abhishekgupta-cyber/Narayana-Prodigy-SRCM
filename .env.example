# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string (e.g. free Neon.tech or Render Postgres)
# When set, server persists all users, edits, and call logs permanently across container restarts with zero refresh limits.
# Leave empty in local/preview to use built-in local JSON storage automatically.
DATABASE_URL=""

# SESSION_SECRET: Optional cryptographic secret for signing session tokens.
SESSION_SECRET=""
